<?xml version="1.0"?>
<launch>
    <!-- AirSim ROS Integration with SlideSLAM -->
    <!-- Arguments -->
    <arg name="host" default="localhost"/>
    <arg name="num_drones" default="3"/>
    <arg name="use_lidar" default="true"/>
    <arg name="use_rgbd" default="false"/>
    
    <!-- Static transforms for coordinate frame alignment -->
    <node pkg="tf" type="static_transform_publisher" name="world_to_map_broadcaster" 
          args="0 0 0 0 0 0 /world /map 100"/>
    
    <!-- AirSim nodes for each drone -->
    <group ns="drone_0">
        <node name="airsim_node" pkg="airsim_ros_pkgs" type="airsim_node" output="screen">
            <param name="host_ip" value="$(arg host)"/>
            <param name="vehicle_name" value="Drone0"/>
            <rosparam file="$(find airsim_ros_pkgs)/config/settings.yaml"/>
        </node>
        
        <!-- SlideSLAM SLOAM for this drone -->
        <include file="$(find sloam)/launch/single_robot_sloam_test.launch">
            <arg name="robot_id" value="0"/>
            <arg name="robot_name" value="drone_0"/>
        </include>
        
        <!-- Object detection and modeling -->
        <include file="$(find object_modeller)/launch/rgb_segmentation_f250.launch" if="$(arg use_rgbd)">
            <arg name="robot_name" value="drone_0"/>
        </include>
        
        <!-- LiDAR processing -->
        <include file="$(find scan2shape)/script/process_cloud_node_outdoor.py" if="$(arg use_lidar)">
            <arg name="robot_name" value="drone_0"/>
        </include>
    </group>
    
    <group ns="drone_1">
        <node name="airsim_node" pkg="airsim_ros_pkgs" type="airsim_node" output="screen">
            <param name="host_ip" value="$(arg host)"/>
            <param name="vehicle_name" value="Drone1"/>
            <rosparam file="$(find airsim_ros_pkgs)/config/settings.yaml"/>
        </node>
        
        <!-- SlideSLAM SLOAM for this drone -->
        <include file="$(find sloam)/launch/single_robot_sloam_test.launch">
            <arg name="robot_id" value="1"/>
            <arg name="robot_name" value="drone_1"/>
        </include>
        
        <!-- Object detection and modeling -->
        <include file="$(find object_modeller)/launch/rgb_segmentation_f250.launch" if="$(arg use_rgbd)">
            <arg name="robot_name" value="drone_1"/>
        </include>
        
        <!-- LiDAR processing -->
        <include file="$(find scan2shape)/script/process_cloud_node_outdoor.py" if="$(arg use_lidar)">
            <arg name="robot_name" value="drone_1"/>
        </include>
    </group>
    
    <group ns="drone_2">
        <node name="airsim_node" pkg="airsim_ros_pkgs" type="airsim_node" output="screen">
            <param name="host_ip" value="$(arg host)"/>
            <param name="vehicle_name" value="Drone2"/>
            <rosparam file="$(find airsim_ros_pkgs)/config/settings.yaml"/>
        </node>
        
        <!-- SlideSLAM SLOAM for this drone -->
        <include file="$(find sloam)/launch/single_robot_sloam_test.launch">
            <arg name="robot_id" value="2"/>
            <arg name="robot_name" value="drone_2"/>
        </include>
        
        <!-- Object detection and modeling -->
        <include file="$(find object_modeller)/launch/rgb_segmentation_f250.launch" if="$(arg use_rgbd)">
            <arg name="robot_name" value="drone_2"/>
        </include>
        
        <!-- LiDAR processing -->
        <include file="$(find scan2shape)/script/process_cloud_node_outdoor.py" if="$(arg use_lidar)">
            <arg name="robot_name" value="drone_2"/>
        </include>
    </group>
    
    <!-- Multi-robot coordination and communication -->
    <include file="$(find multi_robot_utils_launch)/launch/relay_topics_multi_robot.launch">
        <arg name="num_robots" value="$(arg num_drones)"/>
    </include>
    
    <!-- Visualization -->
    <node name="rviz" pkg="rviz" type="rviz" 
          args="-d $(find scan2shape)/rviz/faster-lio-sloam.rviz"/>

</launch>